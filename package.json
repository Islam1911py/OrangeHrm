{
  "name": "orangehrm-ess-playwright",
  "version": "0.1.0",
  "private": true,
  "description": "Functional test automation (Playwright) for the OrangeHRM OS 3.3 ESS 'My Info' module",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke --project=chromium",
    "test:unit": "playwright test --project=unit",
    "explore": "playwright test --project=explore",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "codegen": "playwright codegen $BASE_URL",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "coverage": "node scripts/coverage.mjs",
    "coverage:high": "node scripts/coverage.mjs --priority=High",
    "coverage:summary": "node scripts/coverage.mjs --summary",
    "coverage:next": "node scripts/coverage.mjs --priority=High --type=Functional",
    "results": "node scripts/results.mjs"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.13.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.0"
  }
}
