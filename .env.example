# Copy this file to .env. NEVER commit .env.

# Target: the public OrangeHRM OS 5.9 demo (trailing slash is added automatically if missing).
BASE_URL=https://opensource-demo.orangehrmlive.com/

# The demo's Admin account. It is ONLY used by the setup step to create a fresh ESS user each run.
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=admin123

# Optional: run the tests on Firefox and Edge as well (Phase 2 - compatibility).
# ALL_BROWSERS=1

# Optional: replay a previous run with the SAME generated test data (the seed is printed at the start of every run).
# SEED=123456

# Discovery run (npm run explore): needs NOTHING here. It logs in as Admin and creates a throw-away ESS user by itself.
# Optional: explore an existing ESS account instead (then no data is created):
# EXPLORE_USERNAME=your.ess.username
# EXPLORE_PASSWORD=your-password
